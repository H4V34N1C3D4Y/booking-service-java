<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">

    <changeSet id="1" author="booking-service">
        <comment>Создание таблицы bookings</comment>

        <createTable tableName="bookings">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="status" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="resource_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="booked_from" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="booked_to" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="catalog_request_id" type="UUID"/>
        </createTable>

        <createIndex indexName="idx_bookings_status" tableName="bookings">
            <column name="status"/>
        </createIndex>

        <createIndex indexName="idx_bookings_user_id" tableName="bookings">
            <column name="user_id"/>
        </createIndex>

        <createIndex indexName="idx_bookings_resource_id" tableName="bookings">
            <column name="resource_id"/>
        </createIndex>
    </changeSet>
    <changeSet id="2" author="booking-service">
        <comment>
            Добавление полей для компенсирующей транзакции отмены бронирования
        </comment>
        <addColumn tableName="bookings">
            <column name="previous_status" type="INTEGER">
                <constraints nullable="true"/>
            </column>
            <column name="cancellation_requested_at"
                    type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>
    <changeSet id="3" author="booking-service">
        <comment>Создание таблицы истории изменений статусов бронирований</comment>

        <createTable tableName="booking_history">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="booking_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="previous_status" type="INTEGER">
                <constraints nullable="true"/>
            </column>
            <column name="new_status" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="changed_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="reason" type="VARCHAR(255)">
                <constraints nullable="true"/>
            </column>
            <column name="initiator" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_booking_history_booking_id"
                     tableName="booking_history">
            <column name="booking_id"/>
        </createIndex>
        <addForeignKeyConstraint
                baseTableName="booking_history"
                baseColumnNames="booking_id"
                constraintName="fk_booking_history_booking"
                referencedTableName="bookings"
                referencedColumnNames="id"/>
    </changeSet>
    <changeSet id="4" author="booking-service">
        <comment>
            Создание таблицы обработанных событий для идемпотентности
        </comment>

        <createTable tableName="processed_events">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true"
                             primaryKeyName="pk_processed_events"
                             nullable="false"/>
            </column>
            <column name="event_id" type="UUID">
                <constraints nullable="false"
                             unique="true"
                             uniqueConstraintName="uk_processed_events_event_id"/>
            </column>
            <column name="processed_at" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>

            <column name="booking_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
        </createTable>
        <createIndex
                indexName="idx_processed_events_processed_at"
                tableName="processed_events">
            <column name="processed_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
